    "exif",
    "orientation",
    "heic",
    "heif",
    "preview",
    "retry",
    "upright"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maatify/js-image-upRight.git"
  },
  "homepage": "https://github.com/Maatify/js-image-upRight#readme",
